# ---------------------------------------------------------------------------
# PatchForge Enterprise — Plane 2 environment
#
# Model API keys live in the TrueForge control plane (Plane 1), NOT here.
# See config/README.md.
# ---------------------------------------------------------------------------

# TrueForge control plane. Serves the API AND the admin UI on port 8790.
# On Linux/WSL2 the harness service also needs:
#   extra_hosts: ["host.docker.internal:host-gateway"]
TRUEFOUNDRY_BASE_URL=http://host.docker.internal:8790

# Leave EMPTY unless you configured OIDC on TrueForge. With OIDC unset it
# serves anonymous sessions and an empty bearer header would be rejected.
TRUEFOUNDRY_API_KEY=

# Registry names configured in Plane 1 (see intro.md §5).
# The FQN is <provider>/<model>, and for well-known providers the provider name
# IS its type — so Gemini via the `google-gemini` provider is:
TRUEFORGE_MODEL=google-gemini/gemini-3-6-flash
TRUEFORGE_MCP_SERVER=github

# Reusable agent published to the TrueForge Agents Library at boot ("Save Agent"
# in the UI). Publishing it does not change how the worker runs.
REGISTER_AGENT_ON_BOOT=true
TRUEFORGE_AGENT_DEFINITION_NAME=patchforge-orchestrator

# Set this to make the worker RUN the saved agent instead of building a spec per
# task. Leave empty for the default: a session scoped to exactly the one skill
# the CVE needs, which is more deterministic than letting the model choose from
# all seven.
TRUEFORGE_AGENT_NAME=

# GitHub credential for the MCP gateway (required).
# Fine-grained PAT with contents:write, pull_requests:write, metadata:read.
# One token, two uses: read-only manifest/diff fetches here, and the same PAT
# pasted into Settings > Connectors > GitHub in TrueForge for branches and PRs.
GITHUB_TOKEN=

# Daytona (optional — the STANDALONE local sandbox needs none of this).
#
# TrueForge's sandbox-provider schema carries only an api_key, with no endpoint
# field. The endpoint is instead taken from DAYTONA_API_URL in the environment
# of the TRUEFORGE process: TrueForge constructs the SDK client without an
# apiUrl, and the SDK then falls back to this variable.
#
# Leave DAYTONA_API_URL unset for Daytona Cloud (https://app.daytona.io/api).
# Set it to reach a self-hosted Daytona — see intro.md §9.1 for the caveats,
# which are substantial.
#
# NOTE: this must be set on the TrueForge container/process, not on PatchForge.
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Local Daytona takes host port 3000 (its dashboard URLs hardcode
# localhost:3000), so the harness moves aside when both run together.
HARNESS_HOST_PORT=3000
HARNESS_WS_HOST_PORT=3001

# Scanning cadence. SCAN_ON_BOOT=true sweeps every repo at startup.
SCAN_CRON=0 */6 * * *
SCAN_ON_BOOT=false

# Fail harness startup if Plane 1 assets are missing, rather than warning.
STRICT_PREFLIGHT=false

# Browser-facing URLs baked into the UI build. Change for non-localhost hosts.
# PUBLIC_HARNESS_URL / PUBLIC_POOL_MONITOR_URL are no longer used: the UI
# calls its own origin and Next proxies onward server-side.
# Only needed when the harness is NOT on the host serving the UI.
PUBLIC_HARNESS_WS=

HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CA_BUNDLE_IN_CONTAINER=/etc/ssl/certs/ca-certificates.crt
